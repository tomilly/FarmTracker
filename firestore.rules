rules_version = '2';

// Reguły dostępu FarmTracker. Wkleić w konsoli Firebase: Firestore Database → Reguły → Opublikuj.
// Zasada: każdy widzi tylko swój zbiór; pola, bazę, zaproszenia i ludzi zmienia tylko admin zbioru.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(harvestId) {
      return /databases/$(database)/documents/harvests/$(harvestId)/members/$(request.auth.uid);
    }

    function isMember(harvestId) {
      return signedIn() && exists(memberDoc(harvestId));
    }

    function isAdmin(harvestId) {
      return isMember(harvestId) && get(memberDoc(harvestId)).data.role == 'ADMIN';
    }

    function validRole(role) {
      return role in ['ADMIN', 'HARVESTER', 'DRIVER', 'BASE'];
    }

    // Dołączenie kodem: zaproszenie istnieje, jest do tego zbioru, na tę rolę i jeszcze ważne, a w tym samym zapisie
    // zostaje zużyte (usunięte) – kod działa raz.
    function joinsWithInvite(harvestId, data) {
      let invite = get(/databases/$(database)/documents/invites/$(data.inviteCode)).data;
      return invite.harvestId == harvestId && invite.role == data.role && invite.expiresAt > request.time
        && !existsAfter(/databases/$(database)/documents/invites/$(data.inviteCode));
    }

    // Kod zużywa ten, kto nim właśnie dołącza (jego karta w zbiorze powstaje w tym samym zapisie).
    function usesInvite(harvestId, code) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/harvests/$(harvestId)/members/$(request.auth.uid)).data.inviteCode == code;
    }

    // Do którego zbioru należę – tylko ja.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Zaproszenie konkretnej osoby: czyta się po kodzie (także z konta bez numeru – samym kodem); admin tworzy,
    // widzi listę swoich i wycofuje; dołączający zużywa kod.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin(resource.data.harvestId);
      allow create: if isAdmin(request.resource.data.harvestId) && validRole(request.resource.data.role)
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow delete: if isAdmin(resource.data.harvestId) || usesInvite(resource.data.harvestId, code);
    }

    match /harvests/{harvestId} {
      allow read: if isMember(harvestId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin(harvestId);

      match /members/{uid} {
        allow read: if isMember(harvestId);
        allow create: if validRole(request.resource.data.role) && (
          // Zakładający zbiór zostaje adminem (zbiór powstaje w tym samym zapisie).
          (uid == request.auth.uid && request.resource.data.role == 'ADMIN'
            && getAfter(/databases/$(database)/documents/harvests/$(harvestId)).data.ownerId == request.auth.uid)
          // Dołączenie kodem zaproszenia – na rolę z zaproszenia.
          || (uid == request.auth.uid && joinsWithInvite(harvestId, request.resource.data))
          // Admin przywraca usuniętą osobę („Cofnij").
          || isAdmin(harvestId)
        );
        allow update: if isAdmin(harvestId) && validRole(request.resource.data.role);
        // Admin usuwa innych; każdy może sam wyjść ze zbioru.
        allow delete: if isAdmin(harvestId) || (signedIn() && uid == request.auth.uid);
      }

      match /fields/{fieldId} {
        allow read: if isMember(harvestId);
        allow write: if isAdmin(harvestId);
      }

      // Pozycje pracujących: widzą wszyscy w zbiorze, każdy zapisuje i kasuje tylko swoją.
      match /locations/{uid} {
        allow read: if isMember(harvestId);
        allow write: if isMember(harvestId) && uid == request.auth.uid;
      }
    }
  }
}
